<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-doc-service</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeap-doc-archrepo</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <!--
        The client of the architecture repository's /docs-api: the adapter behind the three upstream ports the
        import reads through - ArchitectureModelUpstream, ArchitectureArtifactUpstream and
        MessageSchemaUpstream.

        An adapter like any other: it depends on the domain and on the technology it needs, and on no other
        adapter. In particular it does not depend on jeap-doc-sitegenerator - a build reads what was imported,
        through ArchitectureModelSource, and never reaches this client at all.
    -->
    <dependencies>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <!-- the RestClient and the @GetExchange interface client built on it, with the request-factory
                 builders it is configured through. The restclient starter and not the webmvc one: a driven
                 adapter that only makes outgoing calls has no use for a servlet container, and jeap-doc-web is
                 what brings one. Declared rather than taken from the security starter's transitives, because
                 ArchRepoClients names ClientHttpRequestFactoryBuilder and HttpClientSettings directly. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <!-- DocsApiDtos and the problem-document reader name JsonMapper and JsonNode directly -->
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- JeapOAuth2RestClientBuilderFactory: the jEAP way of calling another service in the system
                 context, which is what puts <system-name>_@architecture-model_#read in the token. It arrives
                 with the security starter, which is what the parent manages the version of. -->
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-security-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The HTTP server the arch repo client is tested against. The version comes from the parent,
                 which manages this artifact; it brings wiremock-standalone with it. -->
            <groupId>org.wiremock.integrations</groupId>
            <artifactId>wiremock-spring-boot-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
