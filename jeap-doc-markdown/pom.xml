<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-doc-service</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeap-doc-markdown</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <!--
        How a documentation page is written, and nothing else.

        This module has NO dependencies and must keep none - not even on jeap-doc-domain. It is reached from
        the structure templates and from the site generator, and through the templates it ends up on the path
        of the upload validation in the web layer; a dependency here would travel all of that way. The moment
        it needs the domain it has stopped being a syntax helper and has become a page model, which is the
        design this service deliberately did not take.
    -->
    <dependencies>
        <!-- test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
