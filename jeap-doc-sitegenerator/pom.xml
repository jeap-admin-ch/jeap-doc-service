<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-doc-service</artifactId>
        <version>1.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>jeap-doc-sitegenerator</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        Produces the documentation site from what the domain wrote: it prepares a workspace, installs the site
        template over the generated content and runs the site generator over it.
    </description>

    <dependencies>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-domain</artifactId>
        </dependency>
        <dependency>
            <!-- the site template this runs; read from the classpath, never from a directory beside the jar -->
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-site</artifactId>
        </dependency>
        <dependency>
            <!-- what the doc service writes about a site, as the site template reads it -->
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Unpacks the site template's manifest and runs npm ci into target/site-install; configured in
                 the parent, because jeap-doc-web needs exactly the same install for its browser tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
