<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-doc-service</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeap-doc-sitegenerator</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        Produces the documentation site from what the domain wrote: it prepares a workspace, installs the site
        template over the generated content and runs the site generator over it.
    </description>

    <dependencies>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-domain</artifactId>
        </dependency>
        <dependency>
            <!-- how a page is written. The structure templates write through the same one, so the escaping and
                 the front matter of a generated page have a single definition -->
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-markdown</artifactId>
        </dependency>
        <dependency>
            <!-- the site template this runs; read from the classpath, never from a directory beside the jar -->
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-doc-site</artifactId>
        </dependency>
        <dependency>
            <!-- what the doc service writes about a site, as the site template reads it -->
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- jeap-doc-version.properties carries @project.version@, which is what the page describing the
                 documentation names as the version that generated it. Filtered here rather than read from
                 Spring Boot's build-info: an instance repackages its own jar, so build-info would report the
                 instance's version instead of the service's. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/jeap-doc-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/jeap-doc-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Unpacks the site template's manifest and runs npm ci into target/site-install; configured in
                 the parent, because jeap-doc-web needs exactly the same install for its browser tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
